# Copiar como .env y completar. Nunca subir el .env al repositorio.

# Servidor
PORT=3000
NODE_ENV=development
# Puerto del frontend en desarrollo (solo se usa para el CORS por defecto)
PORT_FRONTEND=5173
# Orígenes permitidos por CORS, separados por coma. Si se deja vacío se permite localhost:PORT_FRONTEND.
CORS_ORIGINS=
# Detrás de un proxy o balanceador: cantidad de saltos (1) o true/false.
TRUST_PROXY=

# Base de datos (PostgreSQL de Supabase)
DATABASE_URL=postgresql://usuario:contraseña@host:5432/postgres

# Supabase Storage (imágenes y documentos). Usar la service role key, nunca la anon key.
SUPABASE_URL=https://<proyecto>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Keycloak (validación de los tokens del CMS y del Admin)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=hie-realm
KEYCLOAK_CLIENT_ID=hie-cms-client
