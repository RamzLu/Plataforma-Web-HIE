generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model archivo {
  id                   BigInt                 @id @default(autoincrement())
  nombreOriginal       String                 @db.VarChar(255)
  nombreArchivo        String                 @db.VarChar(255)
  ruta                 String                 @db.VarChar(500)
  extension            String                 @db.VarChar(10)
  mimeType             String                 @db.VarChar(100)
  tamanioBytes         BigInt
  createdAt            DateTime               @default(now())
  autoridad            autoridad[]
  capacitacion         capacitacion[]
  contenido_grafico    contenido_grafico[]
  documento            documento[]
  noticia_archivo      noticia_archivo[]
  profesional          profesional[]
  residencia           residencia[]
  residencia_historial residencia_historial[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model area {
  id               BigInt             @id @default(autoincrement())
  nombre           String             @unique @db.VarChar(150)
  descripcion      String?
  ubicacion        String?            @db.VarChar(255)
  activo           Boolean            @default(true)
  profesional_area profesional_area[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model auditoria {
  id          BigInt   @id @default(autoincrement())
  usuarioId   String   @db.Uuid
  accion      String   @db.VarChar(50)
  entidad     String   @db.VarChar(100)
  entidadId   String?  @db.VarChar(100)
  descripcion String?
  fechaHora   DateTime @default(now())
  usuario     usuario  @relation(fields: [usuarioId], references: [id])

  @@index([entidad, entidadId])
  @@index([usuarioId])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model categoria_documento {
  id          BigInt      @id @default(autoincrement())
  nombre      String      @unique @db.VarChar(100)
  descripcion String?     @db.VarChar(255)
  activo      Boolean     @default(true)
  documento   documento[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model categoria_noticia {
  id          BigInt    @id @default(autoincrement())
  nombre      String    @unique @db.VarChar(100)
  descripcion String?   @db.VarChar(255)
  activo      Boolean   @default(true)
  noticia     noticia[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model configuracion {
  id          BigInt   @id @default(autoincrement())
  clave       String   @unique @db.VarChar(100)
  valor       String
  descripcion String?  @db.VarChar(255)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model contacto_institucional {
  id                        BigInt                    @id @default(autoincrement())
  institucionId             BigInt
  redSocial                 String                    @db.VarChar(50)
  enlace                    String                    @db.VarChar(255)
  informacion_institucional informacion_institucional @relation(fields: [institucionId], references: [id], onDelete: Cascade)

  @@unique([institucionId, redSocial])
  @@index([institucionId])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model documento {
  id                   BigInt              @id @default(autoincrement())
  titulo               String              @db.VarChar(200)
  descripcion          String?
  categoriaId          BigInt
  archivoId            BigInt
  createdBy            String              @db.Uuid
  updatedBy            String?             @db.Uuid
  estado               EstadoEditorial     @default(BORRADOR)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  editorMeta           Json?
  pendingMeta          Json?
  /// Flujo editorial interno (nunca se envía al portal; ver utils/metaEditorial.utils.js)
  rejectionReason      String?
  solicitudEliminacion Json?
  archivo              archivo             @relation(fields: [archivoId], references: [id])
  categoria_documento  categoria_documento @relation(fields: [categoriaId], references: [id])
  creador              usuario             @relation("documento_createdByTousuario", fields: [createdBy], references: [id])
  editor               usuario?            @relation("documento_updatedByTousuario", fields: [updatedBy], references: [id])

  @@index([archivoId])
  @@index([categoriaId])
  @@index([createdBy])
  @@index([estado])
  @@index([updatedBy])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model especialidad {
  id                     BigInt          @id @default(autoincrement())
  nombre                 String          @unique @db.VarChar(150)
  descripcion            String?
  horarios               String?
  requisitos             String?
  ubicacion              String?
  documentacionNecesaria String?
  informacionDerivacion  String?
  estado                 EstadoEditorial @default(BORRADOR)
  editorMeta             Json?
  pendingMeta            Json?
  /// Flujo editorial interno (nunca se envía al portal; ver utils/metaEditorial.utils.js)
  rejectionReason        String?
  solicitudEliminacion   Json?
  createdBy              String?         @db.Uuid
  updatedBy              String?         @db.Uuid
  creador                usuario?        @relation("especialidad_createdByTousuario", fields: [createdBy], references: [id])
  editor                 usuario?        @relation("especialidad_updatedByTousuario", fields: [updatedBy], references: [id])
  profesional            profesional[]

  @@index([createdBy])
  @@index([updatedBy])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model informacion_institucional {
  id                     BigInt                   @id @default(autoincrement())
  nombre                 String                   @db.VarChar(200)
  descripcion            String?
  direccion              String                   @db.VarChar(255)
  localidad              String                   @db.VarChar(100)
  provincia              String                   @db.VarChar(100)
  codigoPostal           String?                  @db.VarChar(20)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  contacto_institucional contacto_institucional[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model noticia {
  id                   BigInt            @id @default(autoincrement())
  titulo               String            @db.VarChar(200)
  contenido            String
  categoriaId          BigInt
  createdBy            String            @db.Uuid
  updatedBy            String?           @db.Uuid
  estado               EstadoEditorial   @default(BORRADOR)
  fechaPublicacion     DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  editorMeta           Json?
  pendingMeta          Json?
  /// Flujo editorial interno (nunca se envía al portal; ver utils/metaEditorial.utils.js)
  rejectionReason      String?
  solicitudEliminacion Json?
  categoria_noticia    categoria_noticia @relation(fields: [categoriaId], references: [id])
  creador              usuario           @relation("noticia_createdByTousuario", fields: [createdBy], references: [id])
  editor               usuario?          @relation("noticia_updatedByTousuario", fields: [updatedBy], references: [id])
  noticia_archivo      noticia_archivo[]

  @@index([categoriaId])
  @@index([createdBy])
  @@index([estado])
  @@index([updatedBy])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model noticia_archivo {
  noticiaId BigInt
  archivoId BigInt
  archivo   archivo @relation(fields: [archivoId], references: [id], onDelete: Cascade)
  noticia   noticia @relation(fields: [noticiaId], references: [id], onDelete: Cascade)

  @@id([noticiaId, archivoId])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model profesional {
  id                   BigInt             @id @default(autoincrement())
  nombre               String             @db.VarChar(100)
  apellido             String             @db.VarChar(100)
  matricula            String?            @db.VarChar(50)
  cargo                String?            @db.VarChar(100)
  especialidadId       BigInt
  /// Foto del profesional. En la base la columna se sigue llamando "archivoId".
  imagenId             BigInt?            @map("archivoId")
  descripcion          String?
  activo               Boolean            @default(true)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  estado               EstadoEditorial    @default(BORRADOR)
  editorMeta           Json?
  pendingMeta          Json?
  /// Flujo editorial interno (nunca se envía al portal; ver utils/metaEditorial.utils.js)
  rejectionReason      String?
  solicitudEliminacion Json?
  createdBy            String?            @db.Uuid
  updatedBy            String?            @db.Uuid
  archivo              archivo?           @relation(fields: [imagenId], references: [id])
  creador              usuario?           @relation("profesional_createdByTousuario", fields: [createdBy], references: [id])
  especialidad         especialidad       @relation(fields: [especialidadId], references: [id])
  editor               usuario?           @relation("profesional_updatedByTousuario", fields: [updatedBy], references: [id])
  profesional_area     profesional_area[]

  @@index([imagenId])
  @@index([especialidadId])
  @@index([estado])
  @@index([createdBy])
  @@index([updatedBy])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model profesional_area {
  profesionalId BigInt
  areaId        BigInt
  area          area        @relation(fields: [areaId], references: [id], onDelete: Cascade)
  profesional   profesional @relation(fields: [profesionalId], references: [id], onDelete: Cascade)

  @@id([profesionalId, areaId])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model rol {
  id          BigInt    @id @default(autoincrement())
  nombre      String    @unique @db.VarChar(50)
  descripcion String?   @db.VarChar(255)
  usuario     usuario[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model servicio {
  id                     BigInt          @id @default(autoincrement())
  nombre                 String          @unique @db.VarChar(150)
  descripcion            String?
  requisitos             String?
  documentacionNecesaria String?
  horarios               String?
  informacionDerivacion  String?
  ubicacion              String?
  estado                 EstadoEditorial @default(BORRADOR)
  editorMeta             Json?
  pendingMeta            Json?
  /// Flujo editorial interno (nunca se envía al portal; ver utils/metaEditorial.utils.js)
  rejectionReason        String?
  solicitudEliminacion   Json?
  createdBy              String?         @db.Uuid
  updatedBy              String?         @db.Uuid
  creador                usuario?        @relation("servicio_createdByTousuario", fields: [createdBy], references: [id])
  editor                 usuario?        @relation("servicio_updatedByTousuario", fields: [updatedBy], references: [id])

  @@index([createdBy])
  @@index([updatedBy])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model usuario {
  id                     String         @id @db.Uuid
  keycloakId             String         @unique @db.Uuid
  username               String         @unique @db.VarChar(100)
  email                  String         @unique @db.VarChar(150)
  nombre                 String         @db.VarChar(100)
  apellido               String         @db.VarChar(100)
  rolId                  BigInt
  activo                 Boolean        @default(true)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  auditoria              auditoria[]
  capacitacionesCreadas  capacitacion[] @relation("capacitacion_createdByTousuario")
  capacitacionesEditadas capacitacion[] @relation("capacitacion_updatedByTousuario")
  documentosCreados      documento[]    @relation("documento_createdByTousuario")
  documentosEditados     documento[]    @relation("documento_updatedByTousuario")
  especialidadesCreadas  especialidad[] @relation("especialidad_createdByTousuario")
  especialidadesEditadas especialidad[] @relation("especialidad_updatedByTousuario")
  noticiasCreadas        noticia[]      @relation("noticia_createdByTousuario")
  noticiasEditadas       noticia[]      @relation("noticia_updatedByTousuario")
  profesionalesCreados   profesional[]  @relation("profesional_createdByTousuario")
  profesionalesEditados  profesional[]  @relation("profesional_updatedByTousuario")
  residenciasCreadas     residencia[]   @relation("residencia_createdByTousuario")
  residenciasEditadas    residencia[]   @relation("residencia_updatedByTousuario")
  serviciosCreados       servicio[]     @relation("servicio_createdByTousuario")
  serviciosEditados      servicio[]     @relation("servicio_updatedByTousuario")
  rol                    rol            @relation(fields: [rolId], references: [id])

  @@index([rolId])
}

model capacitacion {
  id                   BigInt          @id @default(autoincrement())
  titulo               String          @db.VarChar(200)
  descripcion          String?
  contenido            String?
  imagenId             BigInt?
  videoUrl             String?
  enlaceUrl            String?
  fechaInicio          DateTime?
  fechaFin             DateTime?
  estado               EstadoEditorial @default(BORRADOR)
  activo               Boolean         @default(true)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  editorMeta           Json?
  pendingMeta          Json?
  /// Flujo editorial interno (nunca se envía al portal; ver utils/metaEditorial.utils.js)
  rejectionReason      String?
  solicitudEliminacion Json?
  createdBy            String?         @db.Uuid
  updatedBy            String?         @db.Uuid
  creador              usuario?        @relation("capacitacion_createdByTousuario", fields: [createdBy], references: [id])
  archivo              archivo?        @relation(fields: [imagenId], references: [id])
  editor               usuario?        @relation("capacitacion_updatedByTousuario", fields: [updatedBy], references: [id])

  @@index([activo])
  @@index([estado])
  @@index([imagenId])
  @@index([createdBy])
  @@index([updatedBy])
}

model contenido_grafico {
  id                          BigInt                      @id @default(autoincrement())
  titulo                      String                      @db.VarChar(200)
  descripcion                 String?
  altText                     String?
  archivoId                   BigInt?
  enlaceUrl                   String?
  orden                       Int                         @default(0)
  activo                      Boolean                     @default(true)
  tipoId                      BigInt
  ubicacionId                 BigInt
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt
  estado                      EstadoEditorial
  createdBy                   String                      @db.Uuid
  updatedBy                   String?                     @db.Uuid
  approvedBy                  String?                     @db.Uuid
  approvedAt                  DateTime?
  rejectionReason             String?
  pagina                      String                      @db.VarChar(100)
  archivo                     archivo?                    @relation(fields: [archivoId], references: [id])
  tipo_contenido_grafico      tipo_contenido_grafico      @relation(fields: [tipoId], references: [id])
  ubicacion_contenido_grafico ubicacion_contenido_grafico @relation(fields: [ubicacionId], references: [id])

  @@index([activo])
  @@index([archivoId])
  @@index([estado])
  @@index([pagina])
  @@index([pagina, ubicacionId, orden])
  @@index([tipoId])
  @@index([ubicacionId])
}

model residencia {
  id                   BigInt                 @id @default(autoincrement())
  nombre               String                 @db.VarChar(200)
  descripcion          String?
  contenido            String?
  imagenId             BigInt?
  convocatoria         String?
  fechaConvocatoria    DateTime?
  estado               EstadoEditorial        @default(BORRADOR)
  activo               Boolean                @default(true)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  editorMeta           Json?
  pendingMeta          Json?
  /// Flujo editorial interno (nunca se envía al portal; ver utils/metaEditorial.utils.js)
  rejectionReason      String?
  solicitudEliminacion Json?
  createdBy            String?                @db.Uuid
  updatedBy            String?                @db.Uuid
  creador              usuario?               @relation("residencia_createdByTousuario", fields: [createdBy], references: [id])
  archivo              archivo?               @relation(fields: [imagenId], references: [id])
  editor               usuario?               @relation("residencia_updatedByTousuario", fields: [updatedBy], references: [id])
  residencia_historial residencia_historial[]

  @@index([activo])
  @@index([estado])
  @@index([imagenId])
  @@index([createdBy])
  @@index([updatedBy])
}

model residencia_historial {
  id           BigInt     @id @default(autoincrement())
  residenciaId BigInt
  titulo       String     @db.VarChar(200)
  descripcion  String?
  imagenId     BigInt?
  orden        Int        @default(0)
  activo       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  archivo      archivo?   @relation(fields: [imagenId], references: [id])
  residencia   residencia @relation(fields: [residenciaId], references: [id], onDelete: Cascade)

  @@index([activo])
  @@index([imagenId])
  @@index([residenciaId])
}

model tipo_contenido_grafico {
  id                BigInt              @id @default(autoincrement())
  nombre            String              @unique @db.VarChar(100)
  descripcion       String?
  activo            Boolean             @default(true)
  contenido_grafico contenido_grafico[]
}

model ubicacion_contenido_grafico {
  id                BigInt              @id @default(autoincrement())
  nombre            String              @unique @db.VarChar(100)
  descripcion       String?
  activo            Boolean             @default(true)
  contenido_grafico contenido_grafico[]
}

model autoridad {
  id          BigInt   @id @default(autoincrement())
  nombre      String   @db.VarChar(150)
  descripcion String?
  cargo       String   @db.VarChar(150)
  imagenId    BigInt?
  orden       Int      @default(0)
  activo      Boolean  @default(true)
  archivo     archivo? @relation(fields: [imagenId], references: [id])

  @@index([activo, orden])
  @@index([imagenId])
}

enum EstadoEditorial {
  BORRADOR
  PENDIENTE_APROBACION
  RECHAZADO
  APROBADO
  PUBLICADO
  ARCHIVADO
  PROGRAMADO
}
