generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ======================================================
// BLOQUE A - SEGURIDAD Y ADMINISTRACIÓN
// ======================================================

model Rol {
  id          BigInt  @id @default(autoincrement())
  nombre      String  @unique @db.VarChar(50)
  descripcion String? @db.VarChar(255)

  usuarios Usuario[]

  @@map("rol")
}

model Usuario {
  id         String @id @default(uuid()) @db.Uuid
  keycloakId String @unique @db.Uuid
  username   String @unique @db.VarChar(100)
  email      String @unique @db.VarChar(150)
  nombre     String @db.VarChar(100)
  apellido   String @db.VarChar(100)

  rolId  BigInt
  activo Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rol Rol @relation(fields: [rolId], references: [id])

  auditorias                Auditoria[]
  noticiasCreadas           Noticia[]              @relation("NoticiaCreatedBy")
  noticiasActualizadas      Noticia[]              @relation("NoticiaUpdatedBy")
  documentosCreados         Documento[]            @relation("DocumentoCreatedBy")
  documentosActualizados    Documento[]            @relation("DocumentoUpdatedBy")
  bannersCreados            Banner[]               @relation("BannerCreatedBy")
  bannersActualizados       Banner[]               @relation("BannerUpdatedBy")
  publicacionesCreadas      PublicacionAcademica[] @relation("PublicacionCreatedBy")
  publicacionesActualizadas PublicacionAcademica[] @relation("PublicacionUpdatedBy")

  @@index([rolId])
  @@map("usuario")
}

model Auditoria {
  id          BigInt   @id @default(autoincrement())
  usuarioId   String   @db.Uuid
  accion      String   @db.VarChar(50)
  entidad     String   @db.VarChar(100)
  entidadId   String?  @db.VarChar(100)
  descripcion String?
  fechaHora   DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@index([entidad, entidadId])
  @@map("auditoria")
}

// ======================================================
// BLOQUE B - ARCHIVOS
// ======================================================

model Archivo {
  id             BigInt   @id @default(autoincrement())
  nombreOriginal String   @db.VarChar(255)
  nombreArchivo  String   @db.VarChar(255)
  ruta           String   @db.VarChar(500)
  extension      String   @db.VarChar(10)
  mimeType       String   @db.VarChar(100)
  tamanioBytes   BigInt
  createdAt      DateTime @default(now())

  banners       Banner[]
  noticias      NoticiaArchivo[]
  documentos    Documento[]
  profesionales Profesional[]
  publicaciones PublicacionArchivo[]

  @@map("archivo")
}

// ======================================================
// BLOQUE C - BANNERS
// ======================================================

model Banner {
  id          BigInt  @id @default(autoincrement())
  titulo      String  @db.VarChar(150)
  descripcion String?
  enlace      String? @db.VarChar(500)

  archivoId BigInt

  createdBy String  @db.Uuid
  updatedBy String? @db.Uuid

  orden  Int
  activo Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  archivo Archivo @relation(fields: [archivoId], references: [id])

  creador      Usuario  @relation("BannerCreatedBy", fields: [createdBy], references: [id])
  actualizador Usuario? @relation("BannerUpdatedBy", fields: [updatedBy], references: [id])

  @@index([archivoId])
  @@index([createdBy])
  @@index([updatedBy])
  @@map("banner")
}

// ======================================================
// BLOQUE D - NOTICIAS
// ======================================================

model CategoriaNoticia {
  id          BigInt  @id @default(autoincrement())
  nombre      String  @unique @db.VarChar(100)
  descripcion String? @db.VarChar(255)
  activo      Boolean @default(true)

  noticias Noticia[]

  @@map("categoria_noticia")
}

model Noticia {
  id          BigInt @id @default(autoincrement())
  titulo      String @db.VarChar(200)
  contenido   String
  categoriaId BigInt

  createdBy String  @db.Uuid
  updatedBy String? @db.Uuid

  estado           EstadoEditorial
  fechaPublicacion DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categoria CategoriaNoticia @relation(fields: [categoriaId], references: [id])

  creador      Usuario  @relation("NoticiaCreatedBy", fields: [createdBy], references: [id])
  actualizador Usuario? @relation("NoticiaUpdatedBy", fields: [updatedBy], references: [id])

  archivos NoticiaArchivo[]

  @@index([categoriaId])
  @@index([createdBy])
  @@index([updatedBy])
  @@index([estado])
  @@map("noticia")
}

model NoticiaArchivo {
  noticiaId BigInt
  archivoId BigInt

  noticia Noticia @relation(fields: [noticiaId], references: [id], onDelete: Cascade)
  archivo Archivo @relation(fields: [archivoId], references: [id], onDelete: Cascade)

  @@id([noticiaId, archivoId])
  @@map("noticia_archivo")
}

// ======================================================
// BLOQUE E - DOCUMENTACIÓN
// ======================================================

model CategoriaDocumento {
  id          BigInt  @id @default(autoincrement())
  nombre      String  @unique @db.VarChar(100)
  descripcion String? @db.VarChar(255)
  activo      Boolean @default(true)

  documentos Documento[]

  @@map("categoria_documento")
}

model Documento {
  id          BigInt  @id @default(autoincrement())
  titulo      String  @db.VarChar(200)
  descripcion String?

  categoriaId BigInt
  archivoId   BigInt

  createdBy String  @db.Uuid
  updatedBy String? @db.Uuid

  estado EstadoEditorial

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categoria CategoriaDocumento @relation(fields: [categoriaId], references: [id])
  archivo   Archivo            @relation(fields: [archivoId], references: [id])

  creador      Usuario  @relation("DocumentoCreatedBy", fields: [createdBy], references: [id])
  actualizador Usuario? @relation("DocumentoUpdatedBy", fields: [updatedBy], references: [id])

  @@index([categoriaId])
  @@index([archivoId])
  @@index([createdBy])
  @@index([updatedBy])
  @@index([estado])
  @@map("documento")
}

// ======================================================
// BLOQUE F - INFORMACIÓN INSTITUCIONAL
// ======================================================

model InformacionInstitucional {
  id           BigInt  @id @default(autoincrement())
  nombre       String  @db.VarChar(200)
  descripcion  String?
  direccion    String  @db.VarChar(255)
  localidad    String  @db.VarChar(100)
  provincia    String  @db.VarChar(100)
  codigoPostal String? @db.VarChar(20)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contactos ContactoInstitucional[]

  @@map("informacion_institucional")
}

model ContactoInstitucional {
  id            BigInt @id @default(autoincrement())
  institucionId BigInt

  tipo        TipoContacto
  valor       String       @db.VarChar(255)
  descripcion String?      @db.VarChar(255)

  orden  Int     @default(0)
  activo Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institucion InformacionInstitucional @relation(fields: [institucionId], references: [id], onDelete: Cascade)

  @@index([institucionId])
  @@map("contacto_institucional")
}

// ======================================================
// BLOQUE G - SERVICIOS Y ÁREAS
// ======================================================

model Area {
  id          BigInt  @id @default(autoincrement())
  nombre      String  @unique @db.VarChar(150)
  descripcion String?
  ubicacion   String? @db.VarChar(255)

  activo Boolean @default(true)

  servicios     Servicio[]
  profesionales ProfesionalArea[]

  @@map("area")
}

model Servicio {
  id                     BigInt  @id @default(autoincrement())
  nombre                 String  @db.VarChar(150)
  descripcion            String?
  requisitos             String?
  documentacionNecesaria String?
  horarios               String?
  informacionDerivacion  String?
  ubicacion              String?

  areaId BigInt
  activo Boolean @default(true)

  area Area @relation(fields: [areaId], references: [id])

  @@index([areaId])
  @@map("servicio")
}

// ======================================================
// BLOQUE H - PROFESIONALES
// ======================================================

model Especialidad {
  id          BigInt  @id @default(autoincrement())
  nombre      String  @unique @db.VarChar(150)
  descripcion String?
  activo      Boolean @default(true)

  profesionales Profesional[]

  @@map("especialidad")
}

model Profesional {
  id        BigInt  @id @default(autoincrement())
  nombre    String  @db.VarChar(100)
  apellido  String  @db.VarChar(100)
  matricula String? @db.VarChar(50)
  cargo     String? @db.VarChar(100)

  especialidadId BigInt
  archivoId      BigInt?

  descripcion String?
  activo      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  especialidad Especialidad @relation(fields: [especialidadId], references: [id])
  archivo      Archivo?     @relation(fields: [archivoId], references: [id])

  areas ProfesionalArea[]

  @@index([especialidadId])
  @@index([archivoId])
  @@map("profesional")
}

model ProfesionalArea {
  profesionalId BigInt
  areaId        BigInt

  profesional Profesional @relation(fields: [profesionalId], references: [id], onDelete: Cascade)

  area Area @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@id([profesionalId, areaId])
  @@map("profesional_area")
}

// ======================================================
// BLOQUE J - DOCENCIA E INVESTIGACIÓN
// ======================================================

model PublicacionAcademica {
  id          BigInt  @id @default(autoincrement())
  titulo      String  @db.VarChar(200)
  descripcion String?

  tipo        TipoPublicacionAcademica
  fechaEvento DateTime?
  estado      EstadoEditorial

  createdBy String  @db.Uuid
  updatedBy String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creador      Usuario  @relation("PublicacionCreatedBy", fields: [createdBy], references: [id])
  actualizador Usuario? @relation("PublicacionUpdatedBy", fields: [updatedBy], references: [id])

  archivos PublicacionArchivo[]

  @@index([createdBy])
  @@index([updatedBy])
  @@index([estado])
  @@map("publicacion_academica")
}

model PublicacionArchivo {
  publicacionId BigInt
  archivoId     BigInt

  publicacion PublicacionAcademica @relation(fields: [publicacionId], references: [id], onDelete: Cascade)

  archivo Archivo @relation(fields: [archivoId], references: [id], onDelete: Cascade)

  @@id([publicacionId, archivoId])
  @@map("publicacion_archivo")
}

// ======================================================
// BLOQUE K - CONFIGURACIÓN
// ======================================================

model Configuracion {
  id          BigInt  @id @default(autoincrement())
  clave       String  @unique @db.VarChar(100)
  valor       String
  descripcion String? @db.VarChar(255)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("configuracion")
}

// ======================================================
// ENUMS DEL PMV
// ======================================================

enum EstadoEditorial {
  BORRADOR
  PUBLICADO
  ARCHIVADO
}

enum TipoContacto {
  TELEFONO
  EMAIL
  RED_SOCIAL
  OTRO
}

enum TipoPublicacionAcademica {
  CURSO
  JORNADA
  CONGRESO
  PROYECTO_INVESTIGACION
  CONVOCATORIA
}
