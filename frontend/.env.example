# Copiar como .env y completar. Sin este archivo se usan los valores de ejemplo de abajo.

# URL base de la API del backend (incluye /api)
VITE_API_URL=http://localhost:3000/api

# Keycloak (inicio de sesión del CMS y del Admin)
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=hie-realm
VITE_KEYCLOAK_CLIENT_ID=hie-cms-client
